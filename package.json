{
  "name": "multi-image",
  "version": "1.0.0",
  "description": "多圖片畫布展示器 — 在可縮放畫布上同時展示多張圖片",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "build:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron": "^28.0.0"
  },
  "devDependencies": {
    "electron-builder": "^24.0.0",
    "jest": "^29.0.0"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "build": {
    "appId": "io.turingtext.multi-image",
    "productName": "Multi-Image Canvas",
    "copyright": "Copyright © 2026 Kevin Hu",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
